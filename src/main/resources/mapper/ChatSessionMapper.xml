<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.mapper.ChatSessionMapper">

    <resultMap id="BaseResultMap" type="com.library.entity.ChatSession">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.library.entity.ChatSession" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_session (user_id, title) VALUES (#{userId}, #{title})
    </insert>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT id, user_id, title, create_time
        FROM chat_session
        WHERE user_id = #{userId}
        ORDER BY id DESC
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT id, user_id, title, create_time
        FROM chat_session
        WHERE id = #{id}
    </select>

    <update id="updateTitle">
        UPDATE chat_session SET title = #{title} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM chat_session WHERE id = #{id}
    </delete>

</mapper>
