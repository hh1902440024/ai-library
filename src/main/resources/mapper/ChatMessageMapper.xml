<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.mapper.ChatMessageMapper">

    <resultMap id="BaseResultMap" type="com.library.entity.ChatMessage">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.library.entity.ChatMessage" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_message (session_id, role, content) VALUES (#{sessionId}, #{role}, #{content})
    </insert>

    <select id="findBySessionId" resultMap="BaseResultMap">
        SELECT id, session_id, role, content, create_time
        FROM chat_message
        WHERE session_id = #{sessionId}
        ORDER BY id ASC
    </select>

    <delete id="deleteBySessionId">
        DELETE FROM chat_message WHERE session_id = #{sessionId}
    </delete>

</mapper>
